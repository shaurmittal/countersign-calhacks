# Copy to fetch-agents/.env (gitignored). Seeds are secrets: they ARE the agents' identities.
# Make each seed with: python3 -c "import secrets; print(secrets.token_hex(32))"

# ---- Countersign agent (countersign_agent.py) ----
COUNTERSIGN_AGENT_SEED=
# Convex HTTP actions URL (NEXT_PUBLIC_CONVEX_SITE_URL in .env.local)
CONVEX_SITE_URL=https://<deployment>.convex.site
# Same value as the Convex env var AGENT_BRIDGE_SECRET
AGENT_BRIDGE_SECRET=

# ---- Vendor billing agent (vendor_billing_agent.py) ----
VENDOR_AGENT_SEED=
# Where the vendor agent sends its request: Countersign's address, printed by countersign_agent.py
# on startup ("Starting agent with address: agent1q..."). An agent:// prefix is fine.
COUNTERSIGN_AGENT_ADDRESS=
# Optional: the text the vendor agent sends (not an address). Empty = the bank-change scam for #1042.
VENDOR_AGENT_REQUEST_TEXT=
