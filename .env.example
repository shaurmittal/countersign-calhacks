# ---- Next.js (.env.local, written by `npx convex dev`) ----
NEXT_PUBLIC_CONVEX_URL=

# ---- Convex env vars: set with `npx convex env set NAME value`, NOT in this file ----
# ANTHROPIC_API_KEY=            P1
# CLAUDE_MODEL=                 P1  optional, default claude-opus-5-5
# CLAUDE_EFFORT=                P1  optional, default low (keeps SMS -> decision under 10 s)
# TWILIO_ACCOUNT_SID=           P2
# TWILIO_AUTH_TOKEN=            P2
# TWILIO_PHONE_NUMBER=          P2  (the Countersign number, E.164)
# CARTESIA_API_KEY=             P2
# CARTESIA_AGENT_ID=            P2
# CARTESIA_TOOL_SECRET=         P2  (shared secret on /cartesia/tools)
# MOSS_API_KEY=                 P3
# CRS_API_KEY=                  P3
# CRS_BASE_URL=                 P3
# INCREASE_API_KEY=             P4
# AGENT_BRIDGE_SECRET=          P4
# SEED_OWNER_PHONE=             teammate playing Priya (gets OTPs)
# SEED_VENDOR_B_PHONE=          teammate B playing Pixel & Pine (gets the callback)
