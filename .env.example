# ---- Next.js (.env.local, written by `npx convex dev`) ----
NEXT_PUBLIC_CONVEX_URL=

# ---- Convex env vars: set with `npx convex env set NAME value`, NOT in this file ----
# ANTHROPIC_API_KEY=            P1
# CLAUDE_MODEL=                 P1  optional, default claude-opus-5-5
# CLAUDE_EFFORT=                P1  optional, default low (keeps SMS -> decision under 10 s)
# CARTESIA_API_KEY=             P2
# CARTESIA_CALLBACK_AGENT_ID=   P2  (agent that places the vendor callback)
# CARTESIA_CALLBACK_NUMBER_ID=  P2  (ap_... id of the "Countersign callback" number)
# CARTESIA_TOOL_SECRET=         P2  (X-Countersign-Secret header on every Cartesia webhook tool)
# MOSS_API_KEY=                 P3
# CRS_API_KEY=                  P3
# CRS_BASE_URL=                 P3
# INCREASE_API_KEY=             P4  optional: sandbox key; unset = mock ledger only
# INCREASE_ACCOUNT_ID=          P4  sandbox account that pays (set by payments:provisionIncrease)
# AGENT_BRIDGE_SECRET=          P4  X-Agent-Bridge-Secret header from fetch-agents/ to /agent/*
# OWNER_TOTP_SECRET=            P4  base32 TOTP secret in Priya's authenticator app (npm run enroll:owner)
# SEED_OWNER_PHONE=             teammate playing Priya (gets OTPs)
# SEED_VENDOR_B_PHONE=          teammate B playing Pixel & Pine (gets the callback)
