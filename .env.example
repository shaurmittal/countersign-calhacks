# ---- Next.js (.env.local, written by `npx convex dev`) ----
NEXT_PUBLIC_CONVEX_URL=

# ---- Convex env vars: set with `npx convex env set NAME value`, NOT in this file ----
# ANTHROPIC_API_KEY=            P1
# CARTESIA_API_KEY=             P2
# CARTESIA_CALLBACK_AGENT_ID=   P2  (agent that places the vendor callback)
# CARTESIA_CALLBACK_NUMBER_ID=  P2  (ap_... id of the "Countersign callback" number)
# CARTESIA_TOOL_SECRET=         P2  (X-Countersign-Secret header on every Cartesia webhook tool)
# MOSS_API_KEY=                 P3
# CRS_API_KEY=                  P3
# CRS_BASE_URL=                 P3
# INCREASE_API_KEY=             P4
# AGENT_BRIDGE_SECRET=          P4
# SEED_OWNER_PHONE=             teammate playing Priya (gets OTPs)
# SEED_VENDOR_B_PHONE=          teammate B playing Pixel & Pine (gets the callback)
